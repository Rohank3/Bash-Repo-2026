#!/usr/bin/env bash

# This script monitors RAM usage and alerts if it's too high.

# Parse available RAM in Megabytes from the `free -m` command
available_ram=$(free -m | awk '/^Mem:/{print $7}')

echo "Available RAM: $available_ram MB"

# TODO: Convert the $available_ram output to Gigabytes (divide by 1024) and print it.
# Extra Credit TODO: Calculate the percentage of used RAM, and print a warning if usage is over 80%.

available_gb=$(awk "BEGIN {printf \"%.2f\", $available_ram/1024}")
echo "Available RAM: $available_gb GB"

total_ram=$(free -m | awk '/^Mem:/{print $2}')
available_ram=$(free -m | awk '/^Mem:/{print $7}')
used_ram=$((total_ram - available_ram))

usage_percent=$((used_ram * 100 / total_ram))

if [ "$usage_percent" -ge 80 ]; then
    echo "WARNING: High RAM usage! ($usage_percent%)"
else
    echo "RAM usage is normal ($usage_percent%)"
fi